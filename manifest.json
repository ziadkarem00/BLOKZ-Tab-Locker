{
  "manifest_version": 3,
  "name": "BLOKZ — Tab & App Locker",
  "short_name": "BLOKZ",
  "version": "1.3.0",
  "author": "ziadkarem00",
  "homepage_url": "https://github.com/ziadkarem00",
  "description": "Protect Google Photos, WhatsApp, Drive, and any sensitive tab with a 4-digit PIN and anti-uninstall security question.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BLOKZ — Tab Locker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["guard.html", "guard.js", "popup.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "lock-current-tab": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "Instantly lock the active tab with BLOKZ"
    },
    "panic-lock-all": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Instantly re-lock all protected tabs"
    }
  }
}
